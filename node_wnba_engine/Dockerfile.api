# Inference API image for the WNBA engine (serve.py).
# Build context = node_wnba_engine/ (set this dir as the Railway service root).
FROM python:3.13-slim

WORKDIR /app

# System libs needed by lightgbm (libgomp) at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install the lean API dependency set first for better layer caching.
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy the engine source + bundled model artifacts + DuckDB snapshot.
COPY . .

# DuckDB feature store. Point this at a mounted Railway volume in production
# so daily ingests survive redeploys (see DEPLOY_RAILWAY.md).
ENV WNBA_DB_PATH=/app/db/wnba.duckdb

# Railway injects $PORT; default to 8000 for local `docker run`.
EXPOSE 8000
CMD ["sh", "-c", "uvicorn serve:app --host 0.0.0.0 --port ${PORT:-8000}"]
